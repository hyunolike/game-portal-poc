root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# 네임스페이스/usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# var / 표현식
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = when_multiline:suggestion

# 네이밍: 상수/static readonly 는 PascalCase, 그 외 private 필드는 _camelCase
dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# 분석기 조정 (팀 합의 사항 - docs/CODE_REVIEW.md 참고)
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage 소스 생성기 강제는 PoC 에선 과함
dotnet_diagnostic.CA1716.severity = none   # 'Shared' 등 키워드 네이밍 허용
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1062.severity = none   # nullable 참조형으로 대체
dotnet_diagnostic.CA2007.severity = none   # ASP.NET Core 에선 ConfigureAwait 불필요
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1812.severity = none   # DI 로 생성되는 internal 클래스
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.IDE0005.severity = warning  # 불필요한 using

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # 테스트 메서드명 언더스코어 허용
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1816.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
